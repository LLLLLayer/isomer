    "nodes": [
      {
        "name": "pty-exec-bit-heal",
        "summary": "Heal node-pty's spawn-helper exec bit before every spawn",
        "body": "npm does not always preserve the execute bit on the prebuilt\nspawn-helper; the symptom is posix_spawnp failed and a terminal that\ndies on open. chmod it idempotently before spawning — self-healing,\nso a reinstall can never bring the bug back. Verified inside a real\nElectron process.",
        "from": [
          "apps/desktop/src/main/services/pty.ts:2#f94c",
          "apps/desktop/src/main/services/pty.ts:4#7703",
          "apps/desktop/src/main/services/pty.ts:71#d5b8"
        ]
      },
      {
        "name": "workspace-resize-dock",
        "summary": "Draggable pane sizes and a dockable terminal",
        "body": "Every seam is now a splitter with pointer-captured dragging and\npersisted sizes (sidebar, stage column, commit list, stack and\ninspector columns, terminal): a small usePaneSize hook over a\nstorage wrapper with an in-memory fallback, unit-tested. The\nterminal docks at the bottom or the right of the workspace and the\nchoice persists; a pty failure now shows the actual error with a\nretry button instead of flash-closing the drawer; the statusbar's\nempty area drags the window.",
        "from": [
